# ==========================================
# MongoDB Configuration
# ==========================================
# Enter your MongoDB Atlas connection string here
# Example: mongodb+srv://<username>:<password>@cluster0.abcde.mongodb.net/?retryWrites=true&w=majority
MONGO_DB_URL=
MONGODB_URL_KEY=

# MongoDB database and collection names (defaults provided)
MONGO_DATABASE_NAME=KRISHAI
MONGO_COLLECTION_NAME=NetworkData

# ==========================================
# MLflow & DagsHub Configuration
# ==========================================
# Replace with your DagsHub MLflow tracking URI, username, and token
# Example URI: https://dagshub.com/<username>/<repo_name>.mlflow
MLFLOW_TRACKING_URI=
MLFLOW_TRACKING_USERNAME=
MLFLOW_TRACKING_PASSWORD=

# Optional DagsHub repository details
DAGSHUB_REPO_OWNER=
DAGSHUB_REPO_NAME=

# ==========================================
# AWS Deployment Secrets (For GitHub Actions & ECR)
# ==========================================
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_ECR_LOGIN_URI=
ECR_REPOSITORY_NAME=networkssecurity
